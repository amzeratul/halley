---

component:
  name: Scriptable
  category: general
  members:
  - activeStates:
      type: 'Halley::ScriptStateSet'
      canEdit: false
      canSave: true
      canNetwork: true
  - tags:
      type: 'Halley::Vector<Halley::String>'
      canEdit: true
      canSave: true
  - scripts:
      type: 'Halley::Vector<Halley::ResourceReference<Halley::ScriptGraph>>'
      canEdit: true
      canSave: false
  - scriptsStarted:
      type: 'Halley::Vector<Halley::String>'
      canEdit: false
      canSave: false
  - variables:
      type: 'Halley::ScriptVariables'
      canEdit: false
      canSave: true
      canNetwork: true
  - entityReferences:
      type: 'Halley::HashMap<Halley::String, Halley::EntityId>'
      canEdit: true
      canSave: false
      canModifyDynamic: true
  - entityParams:
      type: 'Halley::HashMap<Halley::String, Halley::ConfigNode>'
      canEdit: true
      canSave: false
      canModifyDynamic: true

---

component:
  name: EmbeddedScript
  category: general
  componentDependencies: [Scriptable, Transform2D]
  members:
  - script:
      type: 'Halley::ScriptGraph'
      canEdit: true
      canSave: false
      displayName: Script

---

component:
  name: ScriptTarget
  category: general
  componentDependencies: [Transform2D]
  members:
  - id:
      type: 'Halley::String'

---

component:
  name: ScriptTagTarget
  category: general
  members:
  - tags:
      type: 'Halley::Vector<Halley::String>'
      canEdit: true
      canSave: false
---

message:
  name: StartScript
  members:
  - name: 'Halley::String'
  - tags: 'Halley::Vector<Halley::String>'
  - params: 'Halley::Vector<Halley::ConfigNode>'
  serializable: true

---

message:
  name: TerminateScript
  members:
  - name: 'Halley::String'
  serializable: true

---

message:
  name: TerminateScriptsWithTag
  members:
  - tag: 'Halley::String'
  serializable: true
  destination: allClients

---

systemMessage:
  name: TerminateScriptsWithTag
  members:
  - scriptableId: 'Halley::EntityId'
  - tag: 'Halley::String'
  destination: allClients
  multicast: true
  serializable: true

---

type:
  name: ScriptMessage
  include: halley/scripting/script_message.h

---

message:
  name: SendScriptMsg
  members:
  - msg: 'Halley::ScriptMessage'
  serializable: true

---

systemMessage:
  name: SendScriptMsgNetwork
  members:
  - entityId: 'Halley::EntityId'
  - msg: 'Halley::ScriptMessage'
  serializable: true
  destination: host
  multicast: true

---

systemMessage:
  name: StartHostScriptThread
  members:
  - script: 'Halley::String'
  - entity: 'Halley::EntityId'
  - nodeId: int
  - params: 'Halley::Bytes'
  serializable: true
  destination: host

---

systemMessage:
  name: CancelHostScriptThread
  members:
  - script: 'Halley::String'
  - entity: 'Halley::EntityId'
  - nodeId: int
  serializable: true
  destination: host

---

message:
  name: ReturnHostScriptThread
  members:
  - script: 'Halley::String'
  - nodeId: int
  - params: 'Halley::Bytes'
  serializable: true

---

message:
  name: SetEntityVariable
  members:
  - variable: 'Halley::String'
  - value: 'Halley::ConfigNode'
  serializable: true
  destination: host

---

system:
  name: Script
  families:
  - scriptable:
    - Scriptable: write
    - Transform2D: optional read
  - embeddedScript:
    - Scriptable: write
    - EmbeddedScript: write
  - target:
    - ScriptTarget: read
  indexedFamilies: [ scriptable ]
  strategy: global
  services:
  - ScriptingService
  - DevService
  access:
  - world
  - resources
  - api
  - messageBridge
  messages:
  - StartScript: receive scriptable
  - TerminateScript: receive scriptable
  - TerminateScriptsWithTag: receive scriptable
  - SendScriptMsg: send receive scriptable
  - ReturnHostScriptThread: send receive scriptable
  - SetEntityVariable: receive scriptable
  systemMessages:
  - TerminateScriptsWithTag: receive
  - StartHostScriptThread: send receive
  - CancelHostScriptThread: send receive
  - SendScriptMsgNetwork: send receive

---

system:
  name: ScriptableQuery
  families:
  - scriptable:
    - Scriptable: read
  - tagTargets:
    - ScriptTagTarget: read
  strategy: global
  access:
  - world

...