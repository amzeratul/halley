---

component:
  name: Sprite
  category: graphics
  componentDependencies: [Transform2D]
  members:
  - sprite:
      type: 'Halley::Sprite'
      collapse: true
      canSave: false
  - layer:
      type: int
      defaultValue: 0
      displayName: Layer
  - mask:
      type: 'Halley::OptionalLite<Halley::SpriteMaskBase>'
      displayName: Mask
      canSave: false

---

component:
  name: Colour
  category: graphics
  members:
  - colour:
      type: 'Halley::Colour4f'
      defaultValue: '#FFFFFF'
      displayName: "Colour"
      canSave: false # Saving this is dangerous, hard to keep state consistency
      canEdit: true
      canModifyDynamic: true
      canNetwork: true
  - intensity:
      type: float
      defaultValue: 1
      canSave: false
      canEdit: true
      canModifyDynamic: true
      canNetwork: true
  - propagate:
      type: bool
      defaultValue: true
      canSave: false
      canEdit: true

---

component:
  name: TextLabel
  category: graphics
  componentDependencies: [Transform2D]
  members:
  - text:
      type: 'Halley::TextRenderer'
      collapse: true
      canSave: false
  - layer:
      type: int
      defaultValue: 0
      displayName: Layer
  - mask:
      type: 'Halley::OptionalLite<int>'
      displayName: Mask

---

component:
  name: SpriteAnimation
  category: graphics
  members:
  - player:
      type: 'Halley::AnimationPlayer'
      displayName: Player
      collapse: true
      canNetwork: false
  - updateSprite:
      type: bool
      defaultValue: true
      canSave: false

---

component:
  name: Camera
  category: graphics
  componentDependencies: [Transform2D]
  members:
  - zoom:
      type: float
      defaultValue: 1
      displayName: Zoom
  - id:
      type: 'Halley::String'
      displayName: Id
  - uiOffsets:
      type: 'Halley::HashMap<Halley::String, Halley::Vector2f>'
      displayName: UI-Space Offsets
  - worldOffsets:
      type: 'Halley::HashMap<Halley::String, Halley::Vector2f>'
      displayName: World-Space Offsets
  - integerCoords:
      type: bool
      defaultValue: false
      displayName: Snap to Integer Coords

---

component:
  name: Particles
  category: graphics
  componentDependencies: [Transform2D]
  members:
  - particles:
      type: 'Halley::Particles'
      collapse: true
      canSave: false
  - sprites:
      type: 'Halley::Vector<Halley::Sprite>'
      collapse: true
      displayName: Sprites
      canSave: false
  - animation:
      type: 'Halley::ResourceReference<Halley::Animation>'
      displayName: Animation
      canSave: false
  - sequence:
      type: 'Halley::String'
      displayName: Sequence
      defualtValue: "default"
      canSave: false
  - direction:
      type: 'Halley::String'
      displayName: Direction
      defualtValue: "default"
      canSave: false
  - layer:
      type: int
      defaultValue: 0
      displayName: Layer
  - mask:
      type: 'Halley::OptionalLite<Halley::SpriteMaskBase>'
      displayName: Mask
      canSave: false

---

message:
  name: PlayAnimation
  members:
  - sequence: 'Halley::String'

---

message:
  name: PlayAnimationOnce
  members:
  - sequence: 'Halley::String'

---

systemMessage:
  name: PlayNetworkAnimation
  members:
  - entity: Halley::EntityId
  - animation: std::optional<Halley::String>
  - sequence: Halley::String
  - reverse: bool
  - once: bool
  - direction: Halley::String
  destination: remoteClients
  serializable: true
  multicast: true

---

component:
  name: SpriteAnimationReplicator
  category: graphics

---

component:
  name: SpriteAnimationEvents
  category: graphics
  members:
  - tags:
      type: Halley::Vector<Halley::String>
      canSave: false
  - prevAnimIdx:
      type: uint32_t
      canEdit: false
      canSave: false
      defaultValue: 0
  - prevSeqId:
      type: int
      canEdit: false
      canSave: false
      defaultValue: -1
  - prevDir:
      type: int
      canEdit: false
      canSave: false
      defaultValue: -1
  - prevFrame:
      type: int
      canEdit: false
      canSave: false
      defaultValue: -1

---

system:
  name: SpriteAnimation
  families:
  - main:
    - Transform2D: read
    - Sprite: write
    - SpriteAnimation: write
    - SpriteAnimationEvents: optional write
  - replicator:
    - Sprite: write
    - SpriteAnimationReplicator: read
    - SpriteAnimation: write
  strategy: global
  access:
  - world
  - resources
  messages:
  - PlayAnimation: receive
  - PlayAnimationOnce: receive
  systemMessages:
  - PlayNetworkAnimation: receive
  services:
  - ScreenService

---

message:
    name: StopParticles
    serializable: true

---

system:
  name: Particle
  families:
  - particle:
    - Transform2D: read
    - Particles: write
  strategy: global
  access:
  - world
  services:
  - DevService
  - DebugDrawService
  - ScreenService
  messages:
  - StopParticles: receive particle

---

system:
  name: CameraRender
  families: []
  method: render
  strategy: global
  services:
  - PainterService
  - DevService
  - ScreenService
  access:
  - resources
  - api

...